# Copy this file to `.env` and fill in real values before deploying.
# For local development the defaults below (SQLite + console email) work
# out of the box with no changes required.

# --- Core ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Manila

# --- Database -------------------------------------------------------------
# Set USE_POSTGRES=True in production and fill in the DB_* values.
USE_POSTGRES=False
DB_NAME=lto_reviewer
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# --- JWT ------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Google Sign-In ---------------------------------------------------------
# The "Web application" OAuth client ID from Google Cloud Console (Credentials
# page). Used to verify the audience of ID tokens sent to /api/auth/google.
GOOGLE_OAUTH_CLIENT_ID=

# --- CORS -------------------------------------------------------------------
# Leave CORS_ALLOW_ALL_ORIGINS=True for local development against the
# Flutter app running in an emulator. Lock this down in production.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# --- Email ------------------------------------------------------------------
# Defaults to printing emails to the console. For real delivery via Gmail
# SMTP, create an "app password" and set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LTO Exam Reviewer <no-reply@ltoreviewer.local>

# Base URL used to build links inside verification/reset emails.
FRONTEND_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=2
